# Build stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy all project files
COPY . .

# Restore dependencies for the Blazor UI project
RUN dotnet restore "HR.LeaveManagement.BlazorUI/HR.LeaveManagement.BlazorUI.csproj"

# Publish the Blazor WebAssembly project
RUN dotnet publish "HR.LeaveManagement.BlazorUI/HR.LeaveManagement.BlazorUI.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM nginxinc/nginx-unprivileged:alpine AS final
WORKDIR /usr/share/nginx/html

# Copy the published Blazor WebAssembly files
COPY --from=build /app/publish/wwwroot .

# Copy custom Nginx configuration for Blazor routing
COPY nginx.conf /etc/nginx/conf.d/default.conf

# The Blazor UI listens on port 8080 inside the container
EXPOSE 8080